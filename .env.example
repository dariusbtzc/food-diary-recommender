# Names only. Real values live in .env.local (local), Vercel env vars
# (Production/Preview) and Supabase secrets (Edge Functions).

# Supabase, browser-safe (the publishable key is used under RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Vercel sends it as a Bearer token to /api/cron/* routes.
CRON_SECRET=
