# Names only. Real values live in .env.local (local), Vercel env vars
# (Production/Preview) and Supabase secrets (Edge Functions).

# Supabase, browser-safe (the publishable key is used under RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Vercel sends it as a Bearer token to /api/cron/* routes.
CRON_SECRET=

# Edge Functions. Local values go in supabase/functions/.env; hosted values
# are set with `npx supabase secrets set`. From M2 task 8, GOOGLE_MAPS_API_KEY
# is also needed by Next.js (.env.local and Vercel, Production only).
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
# Postgres sends it as a Bearer token to the worker functions.
PARSE_WORKER_SECRET=
